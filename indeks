       ========================================================================== */
    function buildGlossaryCardsHtml() {
      const q = appState.glossaryPage.query.trim().toLowerCase();
      const cat = appState.glossaryPage.category;

      const filtered = GLOSSARY_TERMS.filter(item => {
        const matchCat = cat === 'Semua' || item.category === cat;
        const matchText = !q || item.term.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q);
        return matchCat && matchText;
      });

      if (filtered.length === 0) {
        return `
          <div class="alert-box alert-warn" role="status">
            Tidak ditemukan istilah yang cocok dengan kata kunci "<strong>${escapeHtml(appState.glossaryPage.query)}</strong>". Coba kata kunci lain atau pilih kategori Semua.
          </div>
        `;
      }

      return `
        <p style="font-size:0.88rem;font-weight:700;color:var(--text-muted);margin:8px 0;">
          Menampilkan ${filtered.length} dari ${GLOSSARY_TERMS.length} istilah:
        </p>
