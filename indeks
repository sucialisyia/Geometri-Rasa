      SoundEngine.click();
      appState.challenge.answers = {};
      appState.challenge.currentIdx = 0;
      appState.challenge.showSummaryView = false;
      renderCurrentPage();
    }

    /* Handler Halaman 10: Ruang Nilai & Salin Refleksi */
    function pickValueScenario(scenarioId, choiceKey) {
      const sc = VALUE_SCENARIOS.find(item => item.id === scenarioId);
      if (!sc) return;
      const ch = sc.choices.find(c => c.key === choiceKey);
      if (!ch) return;

      appState.valuesPage.choices[scenarioId] = choiceKey;
      if (choiceKey === 'best') {
        SoundEngine.correct();
        if (!appState.valuesPage.pointsAwarded[scenarioId]) {
          appState.valuesPage.pointsAwarded[scenarioId] = true;
          appState.points += 5;
        }
      } else {
        SoundEngine.click();
      }

      updateHud();
      renderCurrentPage();

      if (appState.audio.autoRead) {
        NarrationEngine.speakPlainText(ch.feedback);
      }
    }

    function copyReflectionAnswers() {
      SoundEngine.click();
      const g = appState.group;
      const ref = appState.valuesPage.reflection;
      const groupInfo = g.name.trim() ? `${g.name} (${g.className})` : 'Kelompok Belajar Geometri Rasa';

      const compiledText = [
        `REFLEKSI RUANG NILAI — GEOMETRI RASA`,
        `Kelompok: ${groupInfo}`,
        ``,
        `(1) Konsep matematika apa yang paling kamu pahami hari ini?`,
        `Jawaban: ${ref.r1.trim() || '(belum diisi)'}`,
        ``,
        `(2) Di mana model geometri berbeda dari bentuk makanan aslinya?`,
        `Jawaban: ${ref.r2.trim() || '(belum diisi)'}`,
        ``,
        `(3) Nilai apa yang kamu terapkan saat bekerja kelompok? Beri satu contoh.`,
        `Jawaban: ${ref.r3.trim() || '(belum diisi)'}`,
        ``,
        `(4) Apa yang kamu syukuri dari kegiatan belajar ini?`,
        `Jawaban: ${ref.r4.trim() || '(belum diisi)'}`
      ].join('\n');

      const tempArea = document.createElement('textarea');
      tempArea.value = compiledText;
      tempArea.setAttribute('readonly', '');
      tempArea.style.position = 'fixed';
      tempArea.style.left = '-9999px';
      document.body.appendChild(tempArea);
      tempArea.select();

      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch (e) {
        copied = false;
      }
      document.body.removeChild(tempArea);

      appState.valuesPage.copyStatus = copied
        ? '✅ Jawaban refleksi berhasil disalin ke papan klip (clipboard).'
        : 'ℹ️ Teks refleksi telah disiapkan; silakan salin manual dari kotak isian di atas.';
      renderCurrentPage();
    }

