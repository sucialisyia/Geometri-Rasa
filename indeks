            <rect x="268" y="98" width="128" height="8" rx="4" fill="#2f6b3f" />
            ${packetIcons}
            <rect x="268" y="114" width="128" height="26" rx="8" fill="#e3efe2" stroke="#2f6b3f" stroke-width="1.5" />
            <text x="332" y="131" text-anchor="middle" font-size="11.5" font-weight="800" fill="#1f2a22">${formatID(bungkusCount)} Bungkus</text>

            <text x="220" y="26" text-anchor="middle" font-size="11.5" font-weight="800" fill="#2f6b3f">
              ⚖️ Neraca Seimbang · Perbandingan 1 : 2 (${formatID(pisangCount)} : ${formatID(bungkusCount)})
            </text>
          </svg>
          <span class="ilustrasi-badge">ilustrasi</span>
        </div>
      `;
    }

