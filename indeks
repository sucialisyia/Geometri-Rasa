            <text x="${cx}" y="91" text-anchor="middle" font-size="11" font-weight="800" fill="#1f2a22">πr²</text>
            <text x="${cx}" y="142" text-anchor="middle" font-size="11" font-weight="700" fill="#2f6b3f">Lingkaran ${i + 1}</text>
          </g>
        `;
      }).join('');

      return `
