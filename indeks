    function calculateMission1() {
      const calc = appState.m1.nalar.calc;
      const raw1 = String(calc.d1).trim();
      const raw2 = String(calc.d2).trim();
      const raw3 = String(calc.d3).trim();

      if (!raw1 || !raw2 || !raw3) {
        SoundEngine.wrong();
        calc.error = 'Semua kolom diameter (arah 1, 2, dan 3) harus diisi terlebih dahulu.';
        calc.result = null;
        renderCurrentPage();
        return;
      }

      const d1 = parseFloat(raw1);
      const d2 = parseFloat(raw2);
      const d3 = parseFloat(raw3);

      if (Number.isNaN(d1) || Number.isNaN(d2) || Number.isNaN(d3) || d1 <= 0 || d2 <= 0 || d3 <= 0) {
        SoundEngine.wrong();
        calc.error = 'Nilai setiap diameter harus lebih dari 0 cm.';
        calc.result = null;
        renderCurrentPage();
        return;
      }

      const dAvg = (d1 + d2 + d3) / 3;
      const r = dAvg / 2;
      const L = 4 * 3.14 * r * r;
      const V = (4 / 3) * 3.14 * Math.pow(r, 3);
      const maxD = Math.max(d1, d2, d3);
      const minD = Math.min(d1, d2, d3);
      const diffPct = ((maxD - minD) / dAvg) * 100;

      calc.error = '';
      calc.result = { d1, d2, d3, dAvg, r, L, V, maxD, minD, diffPct };
      SoundEngine.correct();
      renderCurrentPage();
    }

