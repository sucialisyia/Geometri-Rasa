    function getPretestScore() {
      let score = 0;
      PRETEST_QUESTIONS.forEach(q => {
        if (appState.pretest.answers[q.id] === q.correctIndex) score++;
      });
      return score;
    }

    function getChallengeScore() {
      let score = 0;
      FINAL_CHALLENGE_QUESTIONS.forEach(q => {
        if (appState.challenge.answers[q.id] === q.correctIndex) score++;
      });
      return score;
    }

    function getMissionQuizScore(missionKey) {
      const banks = { m1: MISSION1_QUIZ, m2: MISSION2_QUIZ, m3: MISSION3_QUIZ, m4: MISSION4_QUIZ };
      const bank = banks[missionKey] || [];
      let score = 0;
      bank.forEach(q => {
        if (appState[missionKey].quiz.answers[q.id] === q.correctIndex) score++;
      });
      return score;
    }

