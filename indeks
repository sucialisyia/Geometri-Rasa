      const idx = ch.currentIdx;
      const q = FINAL_CHALLENGE_QUESTIONS[idx];
      const answeredCount = Object.keys(ch.answers).length;
      const challengeScore = getChallengeScore();
      const pretestScore = getPretestScore();
      const userChoice = ch.answers[q.id];
      const hasAnswered = typeof userChoice === 'number';
      const isCorrect = userChoice === q.correctIndex;
      const letters = ['A', 'B', 'C', 'D'];

      const introNarasi = 'Tantangan Akhir berisi 10 soal yang ditampilkan satu soal per layar. Setiap soal benar bernilai 10 poin, lalu hasilnya dibandingkan dengan skor Uji Awal kalian.';

      const pretestPct = Math.round((pretestScore / 5) * 100);
      const challengePct = Math.round((challengeScore / 10) * 100);
      const diffPct = challengePct - pretestPct;
      const diffLabel = diffPct > 0
        ? `+${formatID(diffPct)}% dibanding Uji Awal`
        : diffPct === 0
          ? 'Sama dengan persentase Uji Awal'
          : `${formatID(diffPct)}% dibanding Uji Awal`;

