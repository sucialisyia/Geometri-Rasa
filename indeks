      if (fEl) fEl.innerHTML = `${isClosed ? 'L = 2πr(r + t)' : 'L = 2πrt + πr<sup>2</sup>'} = ${formatID(L)} cm<sup>2</sup>`;
      if (vEl) vEl.innerHTML = `V = πr<sup>2</sup>t = ${formatID(V)} cm<sup>3</sup>`;
