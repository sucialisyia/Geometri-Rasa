    function getDetectiveCasesFoundCount() {
      return Object.values(appState.detectiveCases).filter(Boolean).length;
    }

    function recordDetectiveCaseFound(caseKey) {
      if (!appState.detectiveCases[caseKey]) {
        appState.detectiveCases[caseKey] = true;
        appState.points += 15;
        const totalFound = getDetectiveCasesFoundCount();
        if (totalFound >= 4 && !appState.badges.detektif) {
          appState.badges.detektif = true;
          SoundEngine.fanfare();
        } else {
          SoundEngine.correct();
        }
        updateHud();
      }
    }

    function toggleBadgeModal(open) {
      SoundEngine.click();
      const modal = document.getElementById('badge-modal');
      modal.classList.toggle('open', open);
      if (open) {
        const casesFound = getDetectiveCasesFoundCount();
        const container = document.getElementById('badge-list-container');
        container.innerHTML = BADGES_META.map(b => {
          const unlocked = appState.badges[b.id];
          const progressNote = b.id === 'detektif' && !unlocked ? ` (${casesFound}/4 kasus ditemukan)` : '';
          return `
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;border-radius:12px;border:1.5px solid ${unlocked ? 'var(--correct)' : 'var(--border-color)'};background:${unlocked ? 'var(--correct-bg)' : 'var(--bg-page)'};">
              <div>
                <strong>${unlocked ? '🏅' : '🔒'} Lencana ${b.name}${progressNote}</strong>
                <div style="font-size:0.84rem;color:var(--text-muted);">${b.desc}</div>
              </div>
              <span style="font-weight:800;font-size:0.8rem;color:${unlocked ? 'var(--correct)' : 'var(--text-muted)'};">
                ${unlocked ? 'Diperoleh' : 'Belum'}
              </span>
            </div>
          `;
        }).join('');
      }
    }

