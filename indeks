    }

    /* Handler Kuis Misi 1–4 */
    function answerMissionQuiz(missionKey, questionId, chosenIdx) {
      const banks = {
        m1: MISSION1_QUIZ,
        m2: MISSION2_QUIZ,
        m3: MISSION3_QUIZ,
        m4: MISSION4_QUIZ
      };
      const badgeKeys = {
        m1: 'onde',
        m2: 'lemmang',
        m3: 'dokodoko',
        m4: 'barongko'
      };

      const bank = banks[missionKey];
      const badgeKey = badgeKeys[missionKey];
      const q = bank.find(item => item.id === questionId);
      if (!q) return;

      const qState = appState[missionKey].quiz;
      qState.answers[questionId] = chosenIdx;
      const isCorrect = chosenIdx === q.correctIndex;

      if (isCorrect) {
        if (!qState.pointsAwarded[questionId]) {
          qState.pointsAwarded[questionId] = true;
          appState.points += 10;
        }
      }

      const allAnswered = Object.keys(qState.answers).length === bank.length;
      if (allAnswered && !appState.badges[badgeKey]) {
        appState.badges[badgeKey] = true;
        qState.celebrated = true;
        SoundEngine.fanfare();
      } else if (isCorrect) {
        SoundEngine.correct();
      } else {
        SoundEngine.wrong();
      }

      updateHud();
      renderCurrentPage();

      if (appState.audio.autoRead) {
        const feedbackSpeech = isCorrect
          ? q.explanationSpeech
          : `Belum tepat. ${q.explanationSpeech.replace(/^Benar!\s*/i, '')}`;
        NarrationEngine.speakPlainText(feedbackSpeech);
      }
    }

    function resetMissionQuiz(missionKey) {
      SoundEngine.click();
      const qState = appState[missionKey].quiz;
      qState.answers = {};
      renderCurrentPage();
    }

    /* Handler Halaman 9: Tantangan Akhir (Satu Soal per Layar) */
