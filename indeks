    /* ==========================================================================
       N. GAMBAR 3D INTERAKTIF DI CANVAS (BOLA, TABUNG, & PRISMA SEGITIGA)
       ========================================================================== */
    function drawSphere3D() {
      const canvas = document.getElementById('canvas-bola-3d');
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const w = Math.max(240, rect.width || 320);
      const h = Math.max(200, rect.height || 240);
      canvas.width = w * dpr;
      canvas.height = h * dpr;

      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      const { r, rotX, rotY, splitAnim } = appState.m1.model;
      const maxRadiusPx = Math.min(w, h) * 0.34;
      const rad = Math.max(26, (r / 6) * maxRadiusPx);
      const cx = w / 2;
      const cy = h / 2;
      const sep = splitAnim * 28;

      ctx.save();
      ctx.fillStyle = 'rgba(31, 42, 34, 0.12)';
      ctx.beginPath();
      ctx.ellipse(cx, cy + rad + 18, rad * 0.85, 10, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      const drawHemisphere = (side) => {
        const offsetX = side * sep;
        ctx.save();
        ctx.translate(cx + offsetX, cy);

        if (side !== 0) {
          ctx.beginPath();
          if (side === -1) {
            ctx.rect(-rad - 15, -rad - 15, rad + 15, rad * 2 + 30);
          } else {
            ctx.rect(0, -rad - 15, rad + 15, rad * 2 + 30);
          }
          ctx.clip();
        }

        const grad = ctx.createRadialGradient(-rad * 0.32, -rad * 0.32, rad * 0.1, 0, 0, rad);
        grad.addColorStop(0, '#62b879');
        grad.addColorStop(0.55, '#2f6b3f');
        grad.addColorStop(1, '#183b22');

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(0, 0, rad, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
        ctx.lineWidth = 1.2;
        for (let i = -2; i <= 2; i++) {
          const latY = (i / 3) * rad * Math.cos(rotX * 0.5);
          const latRx = Math.sqrt(Math.max(0, rad * rad - latY * latY));
          ctx.beginPath();
          ctx.ellipse(0, latY, latRx, Math.max(2, latRx * 0.22), 0, 0, Math.PI * 2);
          ctx.stroke();
        }
        const lonRx = Math.abs(Math.sin(rotY)) * rad;
        ctx.beginPath();
        ctx.ellipse(0, 0, Math.max(3, lonRx), rad, 0, 0, Math.PI * 2);
        ctx.stroke();

        ctx.fillStyle = '#fbf8f1';
        for (let k = 0; k < 28; k++) {
          const theta = (k * 2.399) + rotY;
          const phi = Math.acos(1 - 2 * ((k + 0.5) / 28)) + rotX * 0.4;
          const x3 = rad * 0.92 * Math.sin(phi) * Math.cos(theta);
          const y3 = rad * 0.92 * Math.cos(phi);
          const z3 = rad * 0.92 * Math.sin(phi) * Math.sin(theta);
          if (z3 > -rad * 0.15) {
            ctx.save();
            ctx.translate(x3, y3);
            ctx.rotate(theta);
            ctx.fillRect(-3, -1.2, 6, 2.4);
            ctx.restore();
          }
        }
        ctx.restore();
      };

      if (splitAnim <= 0.02) {
        drawHemisphere(0);
      } else {
        drawHemisphere(-1);
        drawHemisphere(1);

        const sliceRx = Math.max(8, rad * 0.32 * splitAnim);
        [-1, 1].forEach(side => {
          const sx = cx + side * sep;
          ctx.save();
          ctx.fillStyle = '#4ea365';
          ctx.beginPath();
          ctx.ellipse(sx, cy, sliceRx, rad, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = '#ffeaa7';
          ctx.lineWidth = 2;
          ctx.stroke();

          ctx.fillStyle = '#a4581c';
          ctx.beginPath();
          ctx.ellipse(sx, cy, sliceRx * 0.55, rad * 0.55, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        });

        ctx.fillStyle = appState.theme === 'dark' ? '#edf3ee' : '#1f2a22';
        ctx.font = '700 12px "Nunito Sans", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Penampang tengah = Lingkaran (2D)', cx, 20);
      }
    }

    function drawCylinder3D() {
      const canvas = document.getElementById('canvas-tabung-3d');
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const w = Math.max(240, rect.width || 320);
      const h = Math.max(200, rect.height || 240);
      canvas.width = w * dpr;
      canvas.height = h * dpr;

      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      const { r, t, rotX, rotY, isClosed } = appState.m2.model;
      const radX = 24 + ((r - 2) / 6) * 44;
      const cylH = 68 + ((t - 10) / 30) * 86;
      const tilt = 0.22 + Math.abs(Math.sin(rotX)) * 0.22;
      const radY = radX * tilt;

      const cx = w / 2;
      const cy = h / 2 + 6;
      const topY = cy - cylH / 2;
      const botY = cy + cylH / 2;

      ctx.fillStyle = 'rgba(31, 42, 34, 0.13)';
      ctx.beginPath();
      ctx.ellipse(cx, botY + 12, radX * 1.05, radY * 0.9, 0, 0, Math.PI * 2);
      ctx.fill();

      const grad = ctx.createLinearGradient(cx - radX, 0, cx + radX, 0);
      grad.addColorStop(0, '#365c27');
      grad.addColorStop(0.35, '#6ca352');
      grad.addColorStop(0.75, '#4f7d3a');
      grad.addColorStop(1, '#2b4a1e');

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.moveTo(cx - radX, topY);
      ctx.lineTo(cx - radX, botY);
      ctx.ellipse(cx, botY, radX, radY, 0, Math.PI, 0, true);
      ctx.lineTo(cx + radX, topY);
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = '#1f3b16';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.strokeStyle = 'rgba(31, 59, 22, 0.55)';
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      ctx.ellipse(cx, cy, radX, radY * 0.85, 0, 0, Math.PI);
      ctx.stroke();

      const stripeX = cx + Math.sin(rotY) * (radX * 0.85);
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.28)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(stripeX, topY + radY * 0.4);
      ctx.lineTo(stripeX, botY + radY * 0.4);
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(cx, topY, radX, radY, 0, 0, Math.PI * 2);
      if (isClosed) {
        ctx.fillStyle = '#7bb360';
        ctx.fill();
        ctx.strokeStyle = '#1f3b16';
        ctx.lineWidth = 2;
        ctx.stroke();
      } else {
        ctx.fillStyle = '#f5ede0';
        ctx.fill();
        ctx.strokeStyle = '#1f3b16';
        ctx.lineWidth = 2.5;
        ctx.stroke();

        ctx.beginPath();
        ctx.ellipse(cx, topY + 2, radX * 0.82, radY * 0.78, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#d8cbb8';
        ctx.fill();
      }

      ctx.fillStyle = appState.theme === 'dark' ? '#edf3ee' : '#1f2a22';
      ctx.font = '800 11.5px "Nunito Sans", sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(`t = ${formatID(t)} cm`, cx + radX + 8, cy + 4);

      ctx.strokeStyle = '#a4581c';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(cx, topY);
      ctx.lineTo(cx + radX, topY);
      ctx.stroke();
      ctx.textAlign = 'center';
      ctx.fillStyle = '#a4581c';
      ctx.fillText(`r = ${formatID(r)} cm`, cx, topY - radY - 6);
    }

    function drawPrism3D() {
      const canvas = document.getElementById('canvas-prisma-3d');
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const w = Math.max(240, rect.width || 320);
      const h = Math.max(200, rect.height || 240);
      canvas.width = w * dpr;
      canvas.height = h * dpr;

      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      const { rotX, rotY } = appState.m4.model;
      const cx = w / 2;
      const cy = h / 2 + 6;
      const scale = Math.min(w, h) * 0.0145;

      const halfA = 3.6;
      const halfT = 2.4;
      const halfP = 5.4;

      const rawVerts = [
        { x: -halfA, y: halfT, z: halfP },
        { x: halfA, y: halfT, z: halfP },
        { x: 0, y: -halfT, z: halfP },
        { x: -halfA, y: halfT, z: -halfP },
        { x: halfA, y: halfT, z: -halfP },
        { x: 0, y: -halfT, z: -halfP }
      ];

      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);

      const proj = rawVerts.map(v => {
        const x1 = v.x * cosY - v.z * sinY;
        const z1 = v.x * sinY + v.z * cosY;
        const y2 = v.y * cosX - z1 * sinX;
        const z2 = v.y * sinX + z1 * cosX;

        const perspective = 24 / (24 - z2);
        return {
          sx: cx + x1 * scale * 9 * perspective,
          sy: cy + y2 * scale * 9 * perspective,
          z: z2
        };
      });

      const faces = [
        { indices: [0, 1, 2], color: '#4ea365', stroke: '#1f4d2c' },
        { indices: [3, 5, 4], color: '#2f6b3f', stroke: '#1f4d2c' },
        { indices: [0, 2, 5, 3], color: '#3b824d', stroke: '#1f4d2c' },
        { indices: [1, 4, 5, 2], color: '#62b879', stroke: '#1f4d2c' },
        { indices: [0, 3, 4, 1], color: '#235431', stroke: '#1f4d2c' }
      ];

      faces.sort((f1, f2) => {
        const zAvg1 = f1.indices.reduce((sum, idx) => sum + proj[idx].z, 0) / f1.indices.length;
        const zAvg2 = f2.indices.reduce((sum, idx) => sum + proj[idx].z, 0) / f2.indices.length;
        return zAvg1 - zAvg2;
      });

      faces.forEach(face => {
        ctx.beginPath();
        face.indices.forEach((vIdx, idx) => {
          const p = proj[vIdx];
          if (idx === 0) ctx.moveTo(p.sx, p.sy);
          else ctx.lineTo(p.sx, p.sy);
        });
        ctx.closePath();
        ctx.fillStyle = face.color;
        ctx.fill();
        ctx.strokeStyle = face.stroke;
        ctx.lineWidth = 2;
        ctx.lineJoin = 'round';
        ctx.stroke();
      });

      ctx.strokeStyle = '#a4581c';
      ctx.lineWidth = 4;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(proj[2].sx, proj[2].sy);
      ctx.lineTo(proj[5].sx, proj[5].sy);
      ctx.stroke();

      ctx.fillStyle = appState.theme === 'dark' ? '#edf3ee' : '#1f2a22';
      ctx.font = '800 11.5px "Nunito Sans", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Model Prisma Segitiga (a = 6 cm, t = 4 cm, p = 10 cm)', cx, 20);
    }

    function bindCanvasDrag(canvasId, modelState, redrawFn) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      let dragging = false;
      let lastX = 0;
      let lastY = 0;

      const onDown = (x, y) => {
        dragging = true;
        lastX = x;
        lastY = y;
      };
      const onMove = (x, y) => {
        if (!dragging) return;
        const dx = x - lastX;
        const dy = y - lastY;
        lastX = x;
        lastY = y;
        modelState.rotY += dx * 0.015;
        modelState.rotX += dy * 0.015;
        redrawFn();
      };
      const onUp = () => {
        dragging = false;
      };

      canvas.addEventListener('mousedown', e => onDown(e.clientX, e.clientY));
      window.addEventListener('mousemove', e => onMove(e.clientX, e.clientY));
      window.addEventListener('mouseup', onUp);

      canvas.addEventListener('touchstart', e => {
        if (e.touches.length > 0) {
          onDown(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });
      canvas.addEventListener('touchmove', e => {
