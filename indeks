    /* Grafik Garis Sederhana r (1-6 cm) terhadap V dengan Titik Aktif Mengikuti Slider */
    function svgSphereVolumeGraph(currentR) {
      const maxV = 904.32;
      const plotX0 = 64, plotX1 = 440;
      const plotY0 = 185, plotY1 = 26;
      const w = plotX1 - plotX0;
      const h = plotY0 - plotY1;

      const toX = r => plotX0 + ((r - 1) / 5) * w;
      const toY = v => plotY0 - (v / maxV) * h;

      let pathD = '';
      for (let i = 0; i <= 50; i++) {
        const rr = 1 + (i / 50) * 5;
        const vv = (4 / 3) * 3.14 * Math.pow(rr, 3);
        const x = toX(rr).toFixed(1);
        const y = toY(vv).toFixed(1);
        pathD += (i === 0 ? `M ${x} ${y}` : ` L ${x} ${y}`);
      }

      const curV = (4 / 3) * 3.14 * Math.pow(currentR, 3);
      const cx = toX(currentR);
      const cy = toY(curV);

      const xTicks = [1, 2, 3, 4, 5, 6].map(rVal => {
        const x = toX(rVal);
        return `
          <line x1="${x}" y1="${plotY0}" x2="${x}" y2="${plotY0 + 5}" stroke="#4b5b50" stroke-width="1.5" />
          <text x="${x}" y="${plotY0 + 19}" text-anchor="middle" font-size="11" font-weight="700" fill="#1f2a22">${rVal}</text>
        `;
      }).join('');

      const yTicks = [0, 300, 600, 900].map(vVal => {
        const y = toY(vVal);
        return `
          <line x1="${plotX0 - 5}" y1="${y}" x2="${plotX1}" y2="${y}" stroke="#cde0cc" stroke-width="1" stroke-dasharray="3 3" />
          <text x="${plotX0 - 9}" y="${y + 4}" text-anchor="end" font-size="10.5" font-weight="700" fill="#1f2a22">${formatID(vVal)}</text>
        `;
      }).join('');

      return `
        <div class="svg-frame" style="margin:8px 0 0;">
          <svg viewBox="0 0 470 225" role="img" aria-label="Grafik hubungan jari-jari r dari 1 sampai 6 cm terhadap volume bola V">
            <rect x="2" y="2" width="466" height="221" rx="12" fill="#fbf8f1" />
            ${yTicks}
            <line x1="${plotX0}" y1="${plotY1}" x2="${plotX0}" y2="${plotY0}" stroke="#1f2a22" stroke-width="2" />
            <line x1="${plotX0}" y1="${plotY0}" x2="${plotX1}" y2="${plotY0}" stroke="#1f2a22" stroke-width="2" />
            ${xTicks}
            <text x="252" y="218" text-anchor="middle" font-size="11.5" font-weight="800" fill="#2f6b3f">Jari-jari r (cm)</text>
            <text x="16" y="106" text-anchor="middle" font-size="11" font-weight="800" fill="#2f6b3f" transform="rotate(-90 16 106)">Volume V (cm³)</text>

            <path d="${pathD}" fill="none" stroke="#2f6b3f" stroke-width="3" />

            <line x1="${cx}" y1="${cy}" x2="${cx}" y2="${plotY0}" stroke="#a4581c" stroke-width="1.5" stroke-dasharray="4 3" />
            <line x1="${plotX0}" y1="${cy}" x2="${cx}" y2="${cy}" stroke="#a4581c" stroke-width="1.5" stroke-dasharray="4 3" />
            <circle cx="${cx}" cy="${cy}" r="7" fill="#a4581c" stroke="#ffffff" stroke-width="2" />
            <rect x="${Math.min(315, Math.max(70, cx - 58))}" y="${Math.max(12, cy - 34)}" width="128" height="24" rx="6" fill="#a4581c" />
            <text x="${Math.min(379, Math.max(134, cx + 6))}" y="${Math.max(28, cy - 18)}" text-anchor="middle" font-size="10.5" font-weight="800" fill="#ffffff">
              r=${formatID(currentR)} → V=${formatID(curV)}
            </text>
          </svg>
          <span class="ilustrasi-badge">ilustrasi</span>
        </div>
      `;
    }

    /* Visual Jaring-Jaring Tabung Interaktif (Misi 2 Langkah 3) */
    function svgCylinderNet(r, t, isOpenNet, isClosedEnds) {
      const keliling = 2 * 3.14 * r;
      const luasSelimut = keliling * t;
      const luasAlas = 3.14 * r * r;

      if (!isOpenNet) {
        return `
          <div class="svg-frame" style="margin:8px 0 0;">
            <svg viewBox="0 0 440 220" role="img" aria-label="Ilustrasi selimut tabung masih tergulung sebelum jaring dibuka">
              <rect x="4" y="4" width="432" height="212" rx="12" fill="#fbf8f1" />
              <g transform="translate(220, 112)">
                <rect x="-42" y="-58" width="84" height="116" fill="#4f7d3a" stroke="#1f4d2c" stroke-width="2.5" />
                <ellipse cx="0" cy="-58" rx="42" ry="13" fill="${isClosedEnds ? '#6fa156' : '#e3efe2'}" stroke="#1f4d2c" stroke-width="2.5" />
                <ellipse cx="0" cy="58" rx="42" ry="13" fill="#3a6629" stroke="#1f4d2c" stroke-width="2.5" />
                <text x="0" y="4" text-anchor="middle" font-size="12" font-weight="800" fill="#ffffff">Selimut Tergulung</text>
