                <text x="0" y="-76" text-anchor="middle" font-size="11" font-weight="800" fill="#2f6b3f">
                  ${isClosedEnds ? 'Ujung atas: Tertutup' : 'Ujung atas: Terbuka'}
                </text>
              </g>
            </svg>
            <span class="ilustrasi-badge">ilustrasi</span>
          </div>
        `;
      }

      return `
        <div class="svg-frame" style="margin:8px 0 0;">
          <svg viewBox="0 0 440 230" role="img" aria-label="Ilustrasi jaring-jaring tabung terbuka: persegi panjang selimut berukuran 2 pi r kali t dan lingkaran alas">
            <rect x="4" y="4" width="432" height="222" rx="12" fill="#fbf8f1" />
            ${isClosedEnds ? `
              <circle cx="215" cy="36" r="24" fill="#6fa156" stroke="#1f4d2c" stroke-width="2" />
              <text x="275" y="40" font-size="10.5" font-weight="800" fill="#1f2a22">Tutup: πr² = ${formatID(luasAlas)} cm²</text>
            ` : `
              <text x="215" y="36" text-anchor="middle" font-size="11" font-weight="800" fill="#a4581c">(Ujung atas terbuka — tanpa tutup)</text>
            `}

            <rect x="85" y="68" width="260" height="92" rx="4" fill="#4f7d3a" stroke="#1f4d2c" stroke-width="2.5" />
            <text x="215" y="108" text-anchor="middle" font-size="12.5" font-weight="800" fill="#ffffff">
              Selimut: 2πr × t = ${formatID(luasSelimut)} cm²
            </text>
            <text x="215" y="128" text-anchor="middle" font-size="11.5" font-weight="700" fill="#ffeaa7">
              Panjang = 2πr = ${formatID(keliling)} cm
            </text>
            <text x="352" y="118" text-anchor="start" font-size="11.5" font-weight="800" fill="#a4581c">
              t = ${formatID(t)} cm
            </text>

            <circle cx="215" cy="192" r="24" fill="#3a6629" stroke="#1f4d2c" stroke-width="2" />
            <text x="275" y="196" font-size="10.5" font-weight="800" fill="#1f2a22">Alas: πr² = ${formatID(luasAlas)} cm²</text>
          </svg>
          <span class="ilustrasi-badge">ilustrasi</span>
        </div>
      `;
    }

