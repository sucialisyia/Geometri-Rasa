    /* Visual Neraca Perbandingan Senilai Barongko (1 Pisang : 2 Bungkus) - Misi 4 */
    function svgBarongkoScale(bungkusCount) {
      const pisangCount = bungkusCount / 2;
      const shownBananas = Math.min(10, pisangCount);
      const shownPackets = Math.min(12, bungkusCount);

      let bananaIcons = '';
      for (let i = 0; i < shownBananas; i++) {
        const col = i % 5;
        const row = Math.floor(i / 5);
        const bx = 68 + col * 18;
        const by = 84 - row * 16;
        bananaIcons += `<path d="M${bx} ${by} Q${bx + 7} ${by + 8} ${bx + 13} ${by - 2}" fill="none" stroke="#d99b16" stroke-width="4" stroke-linecap="round" />`;
      }

      let packetIcons = '';
      for (let i = 0; i < shownPackets; i++) {
        const col = i % 6;
        const row = Math.floor(i / 6);
        const px = 278 + col * 17;
        const py = 86 - row * 15;
        packetIcons += `<polygon points="${px},${py} ${px - 6},${py + 10} ${px + 6},${py + 10}" fill="#2f6b3f" stroke="#1f4d2c" stroke-width="1" />`;
      }

      return `
        <div class="svg-frame" style="margin:8px 0 0;">
