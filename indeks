      SoundEngine.click();
      appState.m4.nalar.ratioCalc = { pisangResep: '', bungkusResep: '', bungkusBuat: '', isExample: false, result: null, error: '' };
      renderCurrentPage();
    }

    function calculateM4Ratio() {
      const c = appState.m4.nalar.ratioCalc;
      const rawP = String(c.pisangResep).trim();
      const rawBR = String(c.bungkusResep).trim();
      const rawBB = String(c.bungkusBuat).trim();

      if (!rawP || !rawBR || !rawBB) {
        SoundEngine.wrong();
        c.error = 'Semua kolom perbandingan (pisang pada resep, bungkus pada resep, dan bungkus yang dibuat) harus diisi.';
        c.result = null;
        renderCurrentPage();
        return;
      }

      const pisangResep = parseFloat(rawP);
      const bungkusResep = parseFloat(rawBR);
      const bungkusBuat = parseFloat(rawBB);

      if (
        Number.isNaN(pisangResep) || Number.isNaN(bungkusResep) || Number.isNaN(bungkusBuat) ||
        pisangResep <= 0 || bungkusResep <= 0 || bungkusBuat <= 0
      ) {
        SoundEngine.wrong();
        c.error = 'Semua nilai takaran dan jumlah bungkus harus lebih dari 0.';
        c.result = null;
        renderCurrentPage();
        return;
      }

      const pisangPerlu = (bungkusBuat * pisangResep) / bungkusResep;
      const isWhole = Math.abs(pisangPerlu - Math.round(pisangPerlu)) < 1e-9;

      c.error = '';
      c.result = { pisangResep, bungkusResep, bungkusBuat, pisangPerlu, isWhole };
      SoundEngine.correct();
      renderCurrentPage();
    }

    /* Handler Detektif Rumus Misi 1–4 */
    function checkM1Detective(token) {
      const det = appState.m1.detective;
      const wrongTokens = ['r²', 'cm²'];

      if (wrongTokens.includes(token)) {
        det.foundErrors[token] = true;
        SoundEngine.correct();
        const bothFound = det.foundErrors['r²'] && det.foundErrors['cm²'];
        if (bothFound) {
          det.feedbackMsg = '';
          recordDetectiveCaseFound('m1');
        } else {
          det.feedbackMsg = `Bagus! Potongan "${token}" memang salah. Masih ada satu potongan lagi yang salah, coba temukan!`;
        }
      } else {
        det.checkedOk[token] = true;
        SoundEngine.wrong();
        det.feedbackMsg = `Potongan "${token}" sudah benar pada rumus volume setengah bola (V = ⅔πr³). Cari bagian pangkat atau satuannya yang keliru.`;
      }

      renderCurrentPage();
      if (appState.audio.autoRead && det.foundErrors['r²'] && det.foundErrors['cm²']) {
        NarrationEngine.speakPlainText('Rumus volume setengah bola memakai r pangkat 3, bukan r kuadrat, dan satuannya sentimeter kubik. Yang benar: V sama dengan 2 per 3 kali 3,14 kali 1,75 pangkat 3 sekitar 11,22 sentimeter kubik.');
      }
    }

