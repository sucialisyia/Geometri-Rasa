      document.getElementById('hud-badges').textContent = `${earnedCount}/5 Lencana`;

      // Hitung kemajuan seluruh tahapan (0–14)
      let progressSteps = 0;
      if (appState.visitedPages['0']) progressSteps += 3;
      if (appState.group.saved) progressSteps += 6;
      if (appState.visitedPages['2']) progressSteps += 4;
      progressSteps += Object.keys(appState.pretest.answers).length * 1.5; // maks 7.5
      if (appState.visitedPages['4']) progressSteps += 3;

      const missions = [
        { key: 'm1', badge: 'onde' },
        { key: 'm2', badge: 'lemmang' },
        { key: 'm3', badge: 'dokodoko' },
        { key: 'm4', badge: 'barongko' }
      ];
      missions.forEach(m => {
        const stepsCount = Object.keys(appState[m.key].visitedSteps).length;
        progressSteps += Math.min(8, stepsCount);
        if (appState.badges[m.badge]) progressSteps += 5;
      });

      progressSteps += Object.keys(appState.challenge.answers).length * 1;
      progressSteps += Object.keys(appState.valuesPage.choices).length * 1;
      if (appState.visitedPages['11']) progressSteps += 2;
      if (appState.visitedPages['12']) progressSteps += 2.5;
      if (appState.visitedPages['13']) progressSteps += 2;
      if (appState.visitedPages['14']) progressSteps += 2;

      const pct = Math.min(100, Math.round(progressSteps));
      document.getElementById('hud-progress-fill').style.width = `${pct}%`;
      document.getElementById('hud-progress-text').textContent = `${pct}%`;
      document.getElementById('hud-progress-bar').setAttribute('aria-valuenow', String(pct));
