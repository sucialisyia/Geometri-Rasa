<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Geometri Rasa: Belajar Matematika dari Dapur Bugis-Makassar</title>
  <!-- Google Fonts: Bricolage Grotesque & Nunito Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet" />

  <style>
    /* ==========================================================================
       1. VARIABEL TEMA & TOKEN DESAIN (TERANG & GELAP)
       ========================================================================== */
    :root {
      --bg-page: #fbf8f1;          /* Krem kelapa */
      --bg-card: #ffffff;
      --bg-soft: #e3efe2;          /* Hijau muda */
      --bg-soft-warm: #f5ede0;
      --primary: #2f6b3f;          /* Hijau daun pisang */
      --primary-hover: #245431;
      --primary-contrast: #ffffff;
      --accent: #a4581c;           /* Cokelat gula merah */
      --accent-soft: #f7e6d6;
      --text-main: #1f2a22;        /* Teks utama */
      --text-muted: #4b5b50;
      --border-color: #cde0cc;
      --border-strong: #9bbf9a;
      --correct: #1f7a3d;          /* Benar hijau */
      --correct-bg: #dff3e5;
      --wrong: #b3261e;            /* Salah merah */
      --wrong-bg: #fce8e6;
      --highlight-bg: #ffeaa7;
      --highlight-border: #a4581c;
      --shadow-sm: 0 2px 8px rgba(31, 42, 34, 0.06);
      --shadow-md: 0 8px 24px rgba(31, 42, 34, 0.10);
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 22px;
      --font-heading: 'Bricolage Grotesque', 'Trebuchet MS', sans-serif;
      --font-body: 'Nunito Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
      --base-font-size: 16px;
    }

    [data-theme="dark"] {
      --bg-page: #131a15;
      --bg-card: #1b251e;
      --bg-soft: #233327;
      --bg-soft-warm: #2c231b;
      --primary: #4ea365;
      --primary-hover: #62b879;
      --primary-contrast: #0f1711;
      --accent: #df8b46;
      --accent-soft: #38281c;
      --text-main: #edf3ee;
      --text-muted: #b3c4b7;
      --border-color: #2f4234;
      --border-strong: #496650;
      --correct: #4ec473;
      --correct-bg: #193823;
      --wrong: #f2746d;
      --wrong-bg: #3d1c1a;
      --highlight-bg: #4d3b14;
      --highlight-border: #df8b46;
      --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 10px 28px rgba(0, 0, 0, 0.38);
    }

    /* ==========================================================================
       2. RESET, TIPOGRAFI & AKSESIBILITAS
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      font-size: var(--base-font-size);
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: var(--font-body);
      background-color: var(--bg-page);
      color: var(--text-main);
      line-height: 1.65;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-heading);
      line-height: 1.25;
      margin-top: 0;
      color: var(--text-main);
    }

    /* Fokus keyboard terlihat jelas */
    :focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 3px;
    }

    /* Hormati prefers-reduced-motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .skip-link {
      position: absolute;
      top: -60px;
      left: 12px;
      background: var(--primary);
      color: var(--primary-contrast);
      padding: 10px 16px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      z-index: 9999;
      text-decoration: none;
    }
    .skip-link:focus {
      top: 12px;
    }

    /* ==========================================================================
       3. AKSEN POLA KOTAK-KOTAK GEOMETRIS SARUNG BUGIS-MAKASSAR (BUATAN SENDIRI)
       ========================================================================== */
    .sarong-trim {
      height: 8px;
      width: 100%;
      background-image:
        repeating-linear-gradient(
          90deg,
          #2f6b3f 0px, #2f6b3f 16px,
          #e3efe2 16px, #e3efe2 20px,
          #a4581c 20px, #a4581c 36px,
          #fbf8f1 36px, #fbf8f1 40px
        );
      border-bottom: 1px solid rgba(31, 42, 34, 0.12);
    }

    .sarong-card-accent {
      position: relative;
      overflow: hidden;
    }
    .sarong-card-accent::before {
      content: "";
      display: block;
      height: 6px;
      width: 100%;
      background-image:
        repeating-linear-gradient(
          90deg,
          var(--primary) 0px, var(--primary) 14px,
          var(--bg-soft) 14px, var(--bg-soft) 18px,
          var(--accent) 18px, var(--accent) 32px,
          var(--bg-page) 32px, var(--bg-page) 36px
        );
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    /* ==========================================================================
       4. KEPALA HALAMAN & STATUS PROGRES
       ========================================================================== */
    .app-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }

    .header-inner {
      max-width: 1140px;
      margin: 0 auto;
      padding: 10px 14px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .brand-box {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 4px;
      min-height: 44px;
      text-align: left;
      color: var(--text-main);
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: var(--bg-soft);
      border: 2px solid var(--primary);
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .brand-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.15rem;
      line-height: 1.1;
      color: var(--primary);
      display: block;
    }

    .brand-sub {
      font-size: 0.74rem;
      color: var(--text-muted);
      display: block;
    }

    /* Bilah Progres & Lencana */
    .progress-hud {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-soft);
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      flex-wrap: wrap;
    }

    .hud-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-weight: 700;
      font-size: 0.84rem;
      color: var(--text-main);
      background: var(--bg-card);
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      min-height: 34px;
    }

    .hud-badge-btn {
      cursor: pointer;
      min-height: 44px;
      padding: 6px 12px;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .hud-badge-btn:hover {
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    .progress-track-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--primary);
    }

    .progress-track {
      width: 76px;
      height: 10px;
      background: var(--bg-card);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid var(--border-strong);
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--primary);
      border-radius: 999px;
      transition: width 0.35s ease;
    }

    /* Tombol Utilitas Kepala */
    .header-tools {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .tool-btn {
      min-width: 44px;
      min-height: 44px;
      padding: 0 11px;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-main);
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }
    .tool-btn:hover {
      background: var(--bg-soft);
      border-color: var(--primary);
    }
    .tool-btn.active {
      background: var(--primary);
      color: var(--primary-contrast);
      border-color: var(--primary);
    }

    /* ==========================================================================
       5. NAVIGASI UTAMA (DESKTOP DI ATAS, HP DI BAWAH LAYAR)
       ========================================================================== */
    .desktop-nav {
      background: var(--bg-page);
      border-bottom: 1px solid var(--border-color);
      padding: 8px 14px;
    }

    .desktop-nav-inner {
      max-width: 1140px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .nav-chip {
      min-height: 44px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1.5px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s ease;
    }
    .nav-chip:hover {
      border-color: var(--primary);
      background: var(--bg-soft);
    }
    .nav-chip.active {
      background: var(--primary);
      color: var(--primary-contrast);
      border-color: var(--primary);
    }
    .nav-chip.guru-chip {
      border-color: var(--accent);
      color: var(--accent);
    }
    .nav-chip.guru-chip.active {
      background: var(--accent);
      color: #ffffff;
    }

    /* Navigasi Bawah Layar di HP (<= 860px) */
    .mobile-bottom-nav {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 120;
      background: var(--bg-card);
      border-top: 2px solid var(--border-color);
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
      padding: 6px 6px calc(6px + env(safe-area-inset-bottom));
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
    }

    .mob-nav-btn {
      min-height: 48px;
      border: none;
      border-radius: 10px;
      background: transparent;
      color: var(--text-muted);
      font-family: var(--font-body);
      font-size: 0.7rem;
      font-weight: 700;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      cursor: pointer;
      padding: 4px 2px;
    }
    .mob-nav-btn.active {
      background: var(--bg-soft);
      color: var(--primary);
    }
    .mob-nav-btn span.ico {
      font-size: 1.1rem;
      line-height: 1;
    }

    @media (max-width: 860px) {
      .desktop-nav {
        display: none;
      }
      .mobile-bottom-nav {
        display: grid;
      }
      body {
        padding-bottom: 76px;
      }
      .brand-sub {
        display: none;
      }
    }

    @media (max-width: 420px) {
      .header-inner {
        padding: 8px 10px;
        gap: 6px;
      }
      .brand-title {
        font-size: 1rem;
      }
      .progress-track {
        width: 52px;
      }
      .tool-btn {
        padding: 0 8px;
        font-size: 0.82rem;
      }
    }

    /* ==========================================================================
       6. PANEL SUARA & MODAL LENCANA / LACI NAVIGASI
       ========================================================================== */
    .audio-panel {
      display: none;
      position: fixed;
      top: 74px;
      right: 14px;
      width: min(360px, calc(100vw - 24px));
      background: var(--bg-card);
      border: 2px solid var(--primary);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      padding: 16px;
      z-index: 250;
    }
    .audio-panel.open {
      display: block;
      animation: popIn 0.18s ease-out;
    }

    @keyframes popIn {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-color);
    }

    .panel-row {
      margin-bottom: 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .panel-row-inline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      min-height: 44px;
    }

    .switch-label {
      font-weight: 700;
      font-size: 0.92rem;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
    }

    input[type="checkbox"].toggle-chk {
      width: 22px;
      height: 22px;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .rate-group {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }

    .rate-btn {
      min-height: 44px;
      border-radius: 8px;
      border: 1.5px solid var(--border-strong);
      background: var(--bg-page);
      color: var(--text-main);
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
    }
    .rate-btn.active {
      background: var(--primary);
      color: var(--primary-contrast);
      border-color: var(--primary);
    }

    .audio-controls-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }

    select.styled-select,
    input[type="text"].styled-input,
    input[type="number"].styled-input,
    input[type="search"].styled-input,
    textarea.styled-input {
      width: 100%;
      min-height: 44px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--border-strong);
      background: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 0.95rem;
    }

    .voice-note {
      font-size: 0.8rem;
      color: var(--accent);
      font-weight: 600;
      margin: 0;
    }

    /* Overlay & Modal */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 17, 0.6);
      z-index: 300;
      align-items: center;
      justify-content: center;
      padding: 14px;
    }
    .modal-backdrop.open {
      display: flex;
    }
    .modal-box {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      border: 2px solid var(--border-strong);
      width: min(560px, 100%);
      max-height: 85vh;
      overflow-y: auto;
      padding: 20px;
      box-shadow: var(--shadow-md);
    }

    /* ==========================================================================
       7. KONTAINER UTAMA, KARTU, TOMBOL & NARASI SOROT
       ========================================================================== */
    .main-container {
      max-width: 1040px;
      width: 100%;
      margin: 0 auto;
      padding: 18px 14px 28px;
      flex: 1;
    }

    .card {
      background: var(--bg-card);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      margin-bottom: 18px;
    }

    .card-body {
      padding: 20px;
    }

    @media (max-width: 480px) {
      .card-body {
        padding: 15px;
      }
    }

    .page-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--bg-soft);
      color: var(--primary);
      font-weight: 800;
      font-size: 0.8rem;
      padding: 5px 12px;
      border-radius: 999px;
      margin-bottom: 10px;
      border: 1px solid var(--border-color);
    }

    .ref-tag {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--accent);
      background: var(--bg-soft-warm);
      border: 1px solid var(--accent);
      border-radius: 999px;
      padding: 4px 12px;
      margin-bottom: 12px;
    }

    /* Tombol Standar & Utama (min 44px) */
    .btn {
      min-height: 46px;
      padding: 10px 18px;
      border-radius: var(--radius-sm);
      border: 2px solid transparent;
      font-family: var(--font-body);
      font-weight: 800;
      font-size: 0.96rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    }
    .btn:hover:not(:disabled) {
      transform: translateY(-1px);
    }
    .btn:active:not(:disabled) {
      transform: translateY(0);
    }
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-primary {
      background: var(--primary);
      color: var(--primary-contrast);
    }
    .btn-primary:hover:not(:disabled) {
      background: var(--primary-hover);
    }

    .btn-accent {
      background: var(--accent);
      color: #ffffff;
    }
    .btn-accent:hover:not(:disabled) {
      filter: brightness(1.08);
    }

    .btn-outline {
      background: var(--bg-card);
      color: var(--primary);
      border-color: var(--primary);
    }
    .btn-outline:hover:not(:disabled) {
      background: var(--bg-soft);
    }

    .btn-listen {
      background: var(--bg-soft);
      color: var(--primary);
      border: 1.5px solid var(--primary);
      min-height: 44px;
      padding: 8px 14px;
      font-size: 0.9rem;
    }
    .btn-listen.speaking {
      background: var(--accent);
      color: #ffffff;
      border-color: var(--accent);
    }

    /* Kotak Narasi dengan Sorotan Kalimat */
    .narration-box {
      background: var(--bg-soft);
      border-left: 5px solid var(--primary);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      margin: 14px 0;
    }

    .narration-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }

    .narration-label {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--primary);
    }

    .narration-sentence {
      padding: 2px 4px;
      border-radius: 6px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .narration-sentence.speaking-active {
      background-color: var(--highlight-bg);
      box-shadow: 0 0 0 2px var(--highlight-border);
      font-weight: 700;
    }

    /* Ilustrasi SVG / Canvas + Label Kecil "ilustrasi" */
    .svg-frame {
      position: relative;
      background: var(--bg-page);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px;
      margin: 14px 0;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .svg-frame svg {
      width: 100%;
      max-width: 680px;
      height: auto;
      display: block;
    }

    .ilustrasi-badge {
      align-self: flex-end;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 2px 8px;
      border-radius: 999px;
      margin-top: 6px;
      letter-spacing: 0.03em;
    }

    /* ==========================================================================
       8. FORMAT MATEMATIKA HTML RAPI (PECAHAN BERTUMPUK, PANGKAT, INDEKS)
       ========================================================================== */
    .math-expr {
      font-family: 'Nunito Sans', sans-serif;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      vertical-align: middle;
      flex-wrap: wrap;
    }

    .frac {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      vertical-align: middle;
      line-height: 1.1;
      margin: 0 3px;
      font-size: 0.92em;
    }
    .frac > span:first-child {
      border-bottom: 1.8px solid currentColor;
      padding: 0 4px 2px;
    }
    .frac > span:last-child {
      padding: 2px 4px 0;
    }

    /* ==========================================================================
       9. HALAMAN SPESIFIK: PEMBUKA, KELOMPOK, PENGANTAR, UJI AWAL, PETA MISI
       ========================================================================== */
    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 20px;
      align-items: center;
    }
    @media (max-width: 760px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
    }

    .hero-title {
      font-size: clamp(1.9rem, 4.5vw, 2.75rem);
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 6px;
    }

    .hero-subtitle {
      font-size: clamp(1.08rem, 2.5vw, 1.35rem);
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 12px;
    }

    .slogan-pill {
      display: inline-block;
      background: var(--bg-soft-warm);
      border: 1.5px solid var(--accent);
      color: var(--text-main);
      font-weight: 700;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      margin-bottom: 14px;
    }

    .cta-pair {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 16px;
    }
    @media (max-width: 460px) {
      .cta-pair {
        grid-template-columns: 1fr;
      }
    }

    /* Form Data Kelompok & Tabel Gilir Peran */
    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .form-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    @media (max-width: 640px) {
      .form-grid-2, .form-grid-3 {
        grid-template-columns: 1fr;
      }
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .field-group label {
      font-weight: 700;
      font-size: 0.92rem;
    }

    .alert-box {
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      margin: 12px 0;
      border: 1.5px solid;
    }
    .alert-error {
      background: var(--wrong-bg);
      color: var(--wrong);
      border-color: var(--wrong);
    }
    .alert-success {
      background: var(--correct-bg);
      color: var(--correct);
      border-color: var(--correct);
    }
    .alert-warn {
      background: var(--bg-soft-warm);
      color: var(--accent);
      border-color: var(--accent);
    }

    .table-wrap {
      overflow-x: auto;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--border-color);
      margin-top: 12px;
    }

    table.role-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    table.role-table th, table.role-table td {
      padding: 10px 12px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
    }
    table.role-table th {
      background: var(--bg-soft);
      color: var(--primary);
      font-weight: 800;
    }

    /* Video-Narasi Pengantar */
    .video-stage {
      background: var(--bg-page);
      border: 2px solid var(--primary);
      border-radius: var(--radius-lg);
      padding: 16px;
      margin: 14px 0;
    }

    .scene-dots {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .scene-dot {
      min-width: 44px;
      min-height: 44px;
      border-radius: 999px;
      border: 1.5px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-main);
      font-weight: 800;
      cursor: pointer;
    }
    .scene-dot.active {
      background: var(--primary);
      color: var(--primary-contrast);
      border-color: var(--primary);
    }

    .video-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 12px;
    }

    /* Animasi SVG halus di Pengantar */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    .anim-float {
      animation: floatSlow 3.2s ease-in-out infinite;
    }

    /* Kuis Uji Awal & Kuis Misi */
    .quiz-card {
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 16px;
      background: var(--bg-card);
    }

    .quiz-options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 12px;
    }
    @media (max-width: 560px) {
      .quiz-options {
        grid-template-columns: 1fr;
      }
    }

    .opt-btn {
      min-height: 48px;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--border-strong);
      background: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.15s ease;
    }
    .opt-btn:hover:not(:disabled) {
      border-color: var(--primary);
      background: var(--bg-soft);
    }
    .opt-btn.chosen-correct {
      background: var(--correct-bg);
      border-color: var(--correct);
      color: var(--correct);
    }
    .opt-btn.chosen-wrong {
      background: var(--wrong-bg);
      border-color: var(--wrong);
      color: var(--wrong);
    }

    .quiz-feedback {
      margin-top: 10px;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.92rem;
      font-weight: 600;
    }

    /* Peta Misi */
    .station-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-top: 14px;
    }
    @media (max-width: 640px) {
      .station-grid {
        grid-template-columns: 1fr;
      }
    }

    .station-card {
      border: 2px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
      background: var(--bg-card);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .station-card:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .station-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .order-badge {
      background: var(--accent);
      color: #ffffff;
      font-weight: 800;
      font-size: 0.78rem;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .status-badge {
      background: var(--bg-soft);
      color: var(--primary);
      font-weight: 800;
      font-size: 0.78rem;
      padding: 3px 10px;
      border-radius: 999px;
    }

    /* ==========================================================================
       10. KOMPONEN TAHAP 2 & 3: LANGKAH MISI (1-8), CANVAS 3D, KALKULATOR, DETEKTIF
       ========================================================================== */
    .role-banner {
      background: var(--bg-soft);
      border: 1.5px solid var(--primary);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      margin-bottom: 16px;
    }

    .role-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-top: 10px;
    }
    @media (max-width: 720px) {
      .role-grid-4 {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 380px) {
      .role-grid-4 {
        grid-template-columns: 1fr;
      }
    }

    .role-pill-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 0.86rem;
    }

    /* Indikator Langkah Misi 1 - 8 */
    .step-stepper {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 14px 0 18px;
      padding: 10px;
      background: var(--bg-page);
      border-radius: var(--radius-md);
      border: 1.5px solid var(--border-color);
    }

    .step-tab {
      min-height: 44px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1.5px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s ease;
    }
    .step-tab:hover {
      border-color: var(--primary);
      background: var(--bg-soft);
    }
    .step-tab.active {
      background: var(--primary);
      color: var(--primary-contrast);
      border-color: var(--primary);
    }
    .step-tab.visited:not(.active) {
      border-color: var(--primary);
      color: var(--primary);
    }

    .step-panel {
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 18px;
      background: var(--bg-card);
    }

    .step-footer-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1.5px solid var(--border-color);
    }

    /* Slot Unggah Foto Dokumentasi Kelompok */
    .photo-slot {
      border: 2px dashed var(--border-strong);
      border-radius: var(--radius-md);
      background: var(--bg-page);
      padding: 16px;
      text-align: center;
      margin: 14px 0;
    }
    .photo-slot img {
      max-width: 100%;
      max-height: 240px;
      border-radius: var(--radius-sm);
      border: 2px solid var(--primary);
      margin-top: 10px;
      object-fit: contain;
    }

    /* Visual Interaktif 3D Canvas & Grafik */
    .interactive-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 14px 0;
    }
    @media (max-width: 760px) {
      .interactive-grid {
        grid-template-columns: 1fr;
      }
    }

    .canvas-card {
      background: var(--bg-page);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .interactive-canvas {
      width: 100%;
      height: 240px;
      display: block;
      border-radius: var(--radius-sm);
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      touch-action: none;
      cursor: grab;
    }
    .interactive-canvas:active {
      cursor: grabbing;
    }

    .slider-control {
      margin-top: 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .slider-control input[type="range"] {
      width: 100%;
      min-height: 36px;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .live-metrics {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }
    .metric-pill {
      background: var(--bg-soft);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 0.88rem;
      font-weight: 800;
      text-align: center;
    }

    /* Kartu "Perlu kamu tahu" */
    .did-you-know-card {
      background: var(--bg-soft-warm);
      border-left: 5px solid var(--accent);
      border-top: 1.5px solid var(--accent);
      border-right: 1.5px solid var(--accent);
      border-bottom: 1.5px solid var(--accent);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      margin: 14px 0;
    }

    /* Kotak Asumsi Centang */
    .assumption-list {
      display: grid;
      gap: 8px;
      margin: 12px 0;
    }
    .assumption-item {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--border-color);
      background: var(--bg-page);
      font-weight: 700;
      cursor: pointer;
    }

    /* Contoh Bertahap & Kalkulator (termasuk Tab Kalkulator) */
    .formula-banner {
      background: var(--bg-soft-warm);
      border: 1.5px solid var(--accent);
      border-radius: var(--radius-md);
      padding: 12px 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      justify-content: space-around;
      margin: 12px 0;
      font-size: 1.05rem;
    }

    .step-list-reveal {
      display: grid;
      gap: 8px;
      margin: 12px 0;
    }
    .reveal-item {
      background: var(--bg-soft);
      border-left: 4px solid var(--primary);
      padding: 10px 14px;
      border-radius: 8px;
      font-weight: 600;
      animation: popIn 0.2s ease-out;
    }

    .calc-box {
      background: var(--bg-page);
      border: 2px solid var(--primary);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-top: 16px;
    }

    .calc-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .calc-tab-btn {
      min-height: 44px;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--primary);
      background: var(--bg-card);
      color: var(--primary);
      font-family: var(--font-body);
      font-weight: 800;
      font-size: 0.9rem;
      cursor: pointer;
    }
    .calc-tab-btn.active {
      background: var(--primary);
      color: var(--primary-contrast);
    }

    .example-flag {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--accent);
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      padding: 3px 10px;
      border-radius: 999px;
      margin-bottom: 10px;
    }

    .calc-result-card {
      margin-top: 14px;
      background: var(--bg-card);
      border: 1.5px solid var(--border-strong);
      border-radius: var(--radius-sm);
      padding: 14px;
    }

    /* Detektif Rumus */
    .detective-board {
      background: var(--bg-soft-warm);
      border: 2px solid var(--accent);
      border-radius: var(--radius-md);
      padding: 18px;
      margin: 14px 0;
    }

    .snippet-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 14px 0;
      align-items: center;
    }

    .snippet-btn {
      min-height: 46px;
      min-width: 56px;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      border: 2px dashed var(--accent);
      background: var(--bg-card);
      color: var(--text-main);
      font-family: var(--font-heading);
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .snippet-btn:hover {
      background: var(--accent-soft);
      transform: translateY(-1px);
    }
    .snippet-btn.found-error {
      background: var(--wrong-bg);
      border: 2px solid var(--wrong);
      color: var(--wrong);
      text-decoration: line-through;
    }
    .snippet-btn.checked-ok {
      background: var(--correct-bg);
      border: 2px solid var(--correct);
      color: var(--correct);
    }

    /* Kartu Maknai Nilai */
    .value-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin: 12px 0;
    }
    @media (max-width: 680px) {
      .value-grid-2 {
        grid-template-columns: 1fr;
      }
    }

    .value-box {
      background: var(--bg-page);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
    }

    /* Animasi Perayaan Lencana */
    @keyframes badgeCelebrate {
      0% { transform: scale(0.85); opacity: 0; }
      60% { transform: scale(1.06); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .badge-celebration {
      background: var(--correct-bg);
      border: 2px solid var(--correct);
      border-radius: var(--radius-md);
      padding: 18px;
      text-align: center;
      margin-top: 14px;
      animation: badgeCelebrate 0.45s ease-out;
    }

    /* ==========================================================================
       11. KOMPONEN TAHAP 4: TANTANGAN AKHIR, RUANG NILAI, RANGKUMAN, SERTIFIKAT
       ========================================================================== */
    .challenge-nav-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 12px 0 16px;
    }

    .q-pill-btn {
      min-width: 44px;
      min-height: 44px;
      padding: 6px 10px;
      border-radius: 10px;
      border: 1.5px solid var(--border-strong);
      background: var(--bg-page);
      color: var(--text-main);
      font-weight: 800;
      font-size: 0.88rem;
      cursor: pointer;
    }
    .q-pill-btn.active {
      background: var(--primary);
      color: var(--primary-contrast);
      border-color: var(--primary);
    }
    .q-pill-btn.answered-ok:not(.active) {
      background: var(--correct-bg);
      border-color: var(--correct);
      color: var(--correct);
    }
    .q-pill-btn.answered-bad:not(.active) {
      background: var(--wrong-bg);
      border-color: var(--wrong);
      color: var(--wrong);
    }

    .compare-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 14px 0;
    }
    @media (max-width: 640px) {
      .compare-grid {
        grid-template-columns: 1fr;
      }
    }

    .compare-box {
      background: var(--bg-page);
      border: 1.5px solid var(--border-strong);
      border-radius: var(--radius-md);
      padding: 14px;
      text-align: center;
    }

    /* Ruang Nilai: Skenario */
    .scenario-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin: 14px 0;
    }
    @media (max-width: 680px) {
      .scenario-grid {
        grid-template-columns: 1fr;
      }
    }

    .scenario-card {
      background: var(--bg-page);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
    }

    .scenario-choice-btn {
      width: 100%;
      min-height: 48px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 0.9rem;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .scenario-choice-btn:hover {
      border-color: var(--primary);
      background: var(--bg-soft);
    }
    .scenario-choice-btn.picked-best {
      background: var(--correct-bg);
      border-color: var(--correct);
      color: var(--correct);
    }
    .scenario-choice-btn.picked-alt {
      background: var(--bg-soft-warm);
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Rangkuman: Peta Konsep Interaktif */
    .concept-map-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin: 14px 0;
    }
    @media (max-width: 660px) {
      .concept-map-grid {
        grid-template-columns: 1fr;
      }
    }

    .concept-node {
      border: 2px solid var(--border-strong);
      border-radius: var(--radius-md);
      background: var(--bg-card);
      overflow: hidden;
      transition: border-color 0.2s ease;
    }
    .concept-node.open {
      border-color: var(--primary);
    }

    .concept-node-btn {
      width: 100%;
      min-height: 52px;
      padding: 12px 16px;
      border: none;
      background: var(--bg-soft);
      color: var(--text-main);
      font-family: var(--font-heading);
      font-size: 1rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      cursor: pointer;
      text-align: left;
    }
    .concept-node-btn:hover {
      filter: brightness(0.97);
    }

    .concept-node-body {
      padding: 14px 16px;
      border-top: 1px solid var(--border-color);
      font-size: 0.94rem;
      animation: popIn 0.18s ease-out;
    }

    /* Sertifikat Piagam Berbingkai Kotak-Kotak Sarung */
    .certificate-outer {
      padding: 14px;
      border-radius: var(--radius-lg);
      background-image:
        repeating-linear-gradient(
          45deg,
          #2f6b3f 0px, #2f6b3f 14px,
          #e3efe2 14px, #e3efe2 18px,
          #a4581c 18px, #a4581c 32px,
          #fbf8f1 32px, #fbf8f1 36px
        );
      box-shadow: var(--shadow-md);
      margin: 14px 0;
    }

    .certificate-inner {
      background: var(--bg-card);
      border: 3px solid var(--primary);
      border-radius: var(--radius-md);
      padding: 24px 20px;
      text-align: center;
      position: relative;
    }

    .certificate-inner.fanfare-glow {
      animation: badgeCelebrate 0.5s ease-out;
      border-color: var(--accent);
    }

    .cert-members-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      max-width: 560px;
      margin: 12px auto;
    }
    @media (max-width: 520px) {
      .cert-members-grid {
        grid-template-columns: 1fr;
      }
    }

    .cert-member-pill {
      background: var(--bg-soft);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 8px 12px;
      font-weight: 700;
      font-size: 0.92rem;
    }

    .cert-badges-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin: 14px 0;
    }

    .cert-badge-chip {
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 0.84rem;
      font-weight: 800;
      border: 1.5px solid;
    }
    .cert-badge-chip.earned {
      background: var(--correct-bg);
      border-color: var(--correct);
      color: var(--correct);
    }
    .cert-badge-chip.locked {
      background: var(--bg-page);
      border-color: var(--border-color);
      color: var(--text-muted);
      opacity: 0.72;
    }

    /* ==========================================================================
       12. KOMPONEN TAHAP 5: GLOSARIUM, SUMBER APA 7 & TAB MODE GURU
       ========================================================================== */
    .glossary-toolbar {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 14px 0;
    }

    .glossary-filter-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .glossary-grid {
