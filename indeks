    function answerFinalChallenge(questionId, chosenIdx) {
      const q = FINAL_CHALLENGE_QUESTIONS.find(item => item.id === questionId);
      if (!q) return;

      const ch = appState.challenge;
      ch.answers[questionId] = chosenIdx;
      const isCorrect = chosenIdx === q.correctIndex;

      if (isCorrect) {
        SoundEngine.correct();
        if (!ch.pointsAwarded[questionId]) {
          ch.pointsAwarded[questionId] = true;
          appState.points += 10;
        }
      } else {
        SoundEngine.wrong();
      }

      updateHud();
      renderCurrentPage();

      if (appState.audio.autoRead) {
        const prefix = isCorrect ? 'Benar!' : 'Belum tepat.';
        NarrationEngine.speakPlainText(`${prefix} ${q.explanationSpeech}`);
      }
    }

