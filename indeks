        }
      } else {
        det.checkedOk[token] = true;
        SoundEngine.wrong();
        det.feedbackMsg = `Bagian "${token}" tetap dipakai dalam rumus luas selimut tabung (2πrt). Periksa bentuk ujung bambu dan faktor pengalinya.`;
      }

      renderCurrentPage();
      if (appState.audio.autoRead && det.foundErrors['tabung tertutup'] && det.foundErrors['(r + t)']) {
