    /* Visual Pembuktian Luas Segitiga = ½ × a × t dengan Petak Satuan (Misi 3 Langkah 3) */
    function svgTriangleAreaProof(showProof) {
      const cellW = 44;
      const cellH = 32;
      const x0 = 88;
      const y0 = 28;
      const cols = 6;
      const rows = 4;
      const W = cols * cellW;
      const H = rows * cellH;

      const Ax = x0, Ay = y0 + H;
      const Bx = x0 + W, By = y0 + H;
      const Cx = x0 + 2 * cellW, Cy = y0;
      const Mx = x0 + 2 * cellW, My = y0 + H;

      let gridLines = '';
      for (let c = 0; c <= cols; c++) {
        const gx = x0 + c * cellW;
        gridLines += `<line x1="${gx}" y1="${y0}" x2="${gx}" y2="${y0 + H}" stroke="#9bbf9a" stroke-width="1" />`;
      }
      for (let r = 0; r <= rows; r++) {
        const gy = y0 + r * cellH;
        gridLines += `<line x1="${x0}" y1="${gy}" x2="${x0 + W}" y2="${gy}" stroke="#9bbf9a" stroke-width="1" />`;
      }

      const leftoverPieces = !showProof ? `
        <polygon points="${Ax},${Ay} ${x0},${y0} ${Cx},${Cy}" fill="#f7e6d6" stroke="#a4581c" stroke-width="2" />
        <text x="${x0 + cellW * 0.65}" y="${y0 + cellH * 1.15}" text-anchor="middle" font-size="11" font-weight="800" fill="#a4581c">Sisa 1</text>

        <polygon points="${Bx},${By} ${x0 + W},${y0} ${Cx},${Cy}" fill="#f7e6d6" stroke="#a4581c" stroke-width="2" />
        <text x="${x0 + W - cellW * 1.25}" y="${y0 + cellH * 1.15}" text-anchor="middle" font-size="11" font-weight="800" fill="#a4581c">Sisa 2</text>
      ` : `
        <polygon points="${Ax},${Ay} ${x0},${y0} ${Cx},${Cy}" fill="none" stroke="#a4581c" stroke-width="1.5" stroke-dasharray="5 4" />
        <polygon points="${Bx},${By} ${x0 + W},${y0} ${Cx},${Cy}" fill="none" stroke="#a4581c" stroke-width="1.5" stroke-dasharray="5 4" />

        <polygon points="${Ax},${Ay} ${Mx},${My} ${Cx},${Cy}" fill="#df8b46" fill-opacity="0.72" stroke="#a4581c" stroke-width="2.2" />
        <text x="${x0 + cellW * 1.3}" y="${y0 + H - cellH * 0.85}" text-anchor="middle" font-size="10.5" font-weight="800" fill="#ffffff">Sisa 1</text>

        <polygon points="${Mx},${My} ${Bx},${By} ${Cx},${Cy}" fill="#a4581c" fill-opacity="0.72" stroke="#7c3f10" stroke-width="2.2" />
        <text x="${x0 + cellW * 3.3}" y="${y0 + H - cellH * 0.85}" text-anchor="middle" font-size="10.5" font-weight="800" fill="#ffffff">Sisa 2</text>
      `;

      return `
        <div class="svg-frame" style="margin:8px 0 0;">
          <svg viewBox="0 0 440 212" role="img" aria-label="Pembuktian luas segitiga setengah luas persegi panjang menggunakan petak satuan">
            <rect x="4" y="4" width="432" height="204" rx="12" fill="#fbf8f1" />
            <rect x="${x0}" y="${y0}" width="${W}" height="${H}" fill="#ffffff" stroke="#1f2a22" stroke-width="2" />
            <polygon points="${Ax},${Ay} ${Bx},${By} ${Cx},${Cy}" fill="#2f6b3f" fill-opacity="0.85" stroke="#1f4d2c" stroke-width="2.5" />

            ${leftoverPieces}
            ${gridLines}

            <line x1="${Cx}" y1="${Cy}" x2="${Mx}" y2="${My}" stroke="#ffeaa7" stroke-width="2" stroke-dasharray="4 3" />
            <text x="${Cx - 8}" y="${y0 + H / 2}" text-anchor="end" font-size="11.5" font-weight="800" fill="#1f2a22">t = 4</text>
            <text x="${x0 + W / 2}" y="${y0 + H + 18}" text-anchor="middle" font-size="11.5" font-weight="800" fill="#2f6b3f">Alas a = 6 petak satuan</text>
            <text x="220" y="196" text-anchor="middle" font-size="11" font-weight="800" fill="#a4581c">
              ${showProof
                ? 'Sisa 1 + Sisa 2 tepat menutup segitiga! Luas segitiga = ½ × (6 × 4) = 12 petak satuan'
                : 'Persegi panjang = 24 petak satuan (6 × 4). Klik "Tunjukkan" untuk memindahkan dua bagian sisa.'}
            </text>
          </svg>
          <span class="ilustrasi-badge">ilustrasi</span>
        </div>
      `;
    }

