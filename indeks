    /* Format angka Indonesia: koma desimal, titik ribuan */
    function formatID(num, maxDecimals = 2) {
      if (typeof num !== 'number' || Number.isNaN(num)) return String(num);
      return num.toLocaleString('id-ID', { maximumFractionDigits: maxDecimals });
    }

    /* ==========================================================================
       B. SISTEM EFEK BUNYI & MUSIK LATAR PENTATONIK (WEB AUDIO API)
       ========================================================================== */
    const SoundEngine = (() => {
      let ctx = null;
      let bgmTimer = null;
      let bgmGain = null;
      let noteStep = 0;
      const pentatonicFreqs = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25, 440.00, 392.00, 329.63, 293.66];

      function ensureCtx() {
        try {
          if (!ctx) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) ctx = new AudioCtx();
          }
          if (ctx && ctx.state === 'suspended') {
            ctx.resume();
          }
          return ctx;
        } catch (e) {
          return null;
        }
      }

      function playTone(freq, duration, type = 'sine', gainVal = 0.12, delay = 0) {
        if (!appState.audio.sfx) return;
        try {
          const ac = ensureCtx();
          if (!ac) return;
          const now = ac.currentTime + delay;
          const osc = ac.createOscillator();
          const gain = ac.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, now);

          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.exponentialRampToValueAtTime(gainVal, now + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

          osc.connect(gain);
          gain.connect(ac.destination);
          osc.start(now);
          osc.stop(now + duration + 0.02);
        } catch (e) {}
      }

      function click() {
        playTone(520, 0.06, 'triangle', 0.07, 0);
      }

      function correct() {
        playTone(523.25, 0.14, 'sine', 0.13, 0);
        playTone(659.25, 0.16, 'sine', 0.13, 0.11);
        playTone(783.99, 0.24, 'sine', 0.14, 0.22);
      }

      function wrong() {
        playTone(349.23, 0.18, 'triangle', 0.11, 0);
        playTone(293.66, 0.26, 'triangle', 0.11, 0.15);
      }

      function chime() {
        playTone(659.25, 0.18, 'sine', 0.10, 0);
        playTone(987.77, 0.30, 'sine', 0.10, 0.12);
      }

      function fanfare() {
        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((f, idx) => playTone(f, 0.22, 'triangle', 0.13, idx * 0.11));
      }

      function startBgm() {
        try {
          stopBgm();
          const ac = ensureCtx();
          if (!ac) return;
          bgmGain = ac.createGain();
          bgmGain.gain.setValueAtTime(appState.audio.bgmVolume, ac.currentTime);
          bgmGain.connect(ac.destination);

          const triggerNote = () => {
            if (!appState.audio.bgm) return;
            try {
              const now = ac.currentTime;
              const freq = pentatonicFreqs[noteStep % pentatonicFreqs.length];
              noteStep++;

              const osc = ac.createOscillator();
              const env = ac.createGain();
              osc.type = 'sine';
              osc.frequency.setValueAtTime(freq, now);

              env.gain.setValueAtTime(0.0001, now);
              env.gain.exponentialRampToValueAtTime(0.45, now + 0.08);
              env.gain.exponentialRampToValueAtTime(0.0001, now + 0.85);

              osc.connect(env);
              env.connect(bgmGain);
              osc.start(now);
              osc.stop(now + 0.9);
            } catch (e) {}
          };

          triggerNote();
          bgmTimer = window.setInterval(triggerNote, 950);
        } catch (e) {}
      }

      function stopBgm() {
        try {
          if (bgmTimer) {
            clearInterval(bgmTimer);
            bgmTimer = null;
          }
        } catch (e) {}
      }

      function setVolume(val) {
        try {
          if (bgmGain && ctx) {
            bgmGain.gain.setValueAtTime(Number(val), ctx.currentTime);
          }
        } catch (e) {}
      }

      return { click, correct, wrong, chime, fanfare, startBgm, stopBgm, setVolume };
    })();

    /* ==========================================================================
       C. SISTEM NARASI & SOROTAN KALIMAT (Web Speech API speechSynthesis)
       ========================================================================== */
    const NarrationEngine = (() => {
      let availableVoices = [];
      let activeBoxId = null;
      let sentencesQueue = [];
      let currentIdx = 0;
      let isSpeaking = false;
      let isPaused = false;
      let onDoneCallback = null;

      function refreshVoices() {
        try {
          if (!('speechSynthesis' in window)) return;
          const all = window.speechSynthesis.getVoices() || [];
          const idVoices = all.filter(v => (v.lang || '').toLowerCase().startsWith('id'));
          availableVoices = idVoices;

          const selectEl = document.getElementById('voice-select');
          const msgEl = document.getElementById('voice-status-msg');
          if (!selectEl || !msgEl) return;

          selectEl.innerHTML = '';
          if (idVoices.length > 0) {
            idVoices.forEach(v => {
              const opt = document.createElement('option');
              opt.value = v.voiceURI;
              opt.textContent = `${v.name} (${v.lang})`;
              selectEl.appendChild(opt);
            });
            if (!appState.audio.voiceURI || !idVoices.some(v => v.voiceURI === appState.audio.voiceURI)) {
              appState.audio.voiceURI = idVoices[0].voiceURI;
            }
            selectEl.value = appState.audio.voiceURI;
            msgEl.textContent = `Ditemukan ${idVoices.length} suara bahasa Indonesia.`;
          } else {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = 'Suara bawaan perangkat';
            selectEl.appendChild(opt);
            appState.audio.voiceURI = '';
            msgEl.textContent = 'Suara bahasa Indonesia tidak ditemukan di perangkat ini';
          }
        } catch (e) {}
      }

      try {
        if ('speechSynthesis' in window) {
          refreshVoices();
          window.speechSynthesis.onvoiceschanged = refreshVoices;
        }
      } catch (e) {}

      function clearHighlights() {
        document.querySelectorAll('.narration-sentence.speaking-active').forEach(el => {
          el.classList.remove('speaking-active');
        });
        document.querySelectorAll('.btn-listen.speaking').forEach(btn => {
          btn.classList.remove('speaking');
          btn.innerHTML = '▶ Dengarkan';
        });
      }

      function stop() {
        try {
          isSpeaking = false;
          isPaused = false;
          sentencesQueue = [];
          currentIdx = 0;
          activeBoxId = null;
          onDoneCallback = null;
          if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
          }
          clearHighlights();
        } catch (e) {
          clearHighlights();
        }
      }

      function pause() {
        try {
          if ('speechSynthesis' in window && isSpeaking && !isPaused) {
            window.speechSynthesis.pause();
            isPaused = true;
          }
        } catch (e) {}
      }

      function resume() {
        try {
          if ('speechSynthesis' in window && isPaused) {
            window.speechSynthesis.resume();
            isPaused = false;
          }
        } catch (e) {}
      }

      function speakNextSentence() {
        if (!isSpeaking || currentIdx >= sentencesQueue.length) {
          const cb = onDoneCallback;
          stop();
          if (typeof cb === 'function') cb();
          return;
        }

        try {
          if (!('speechSynthesis' in window)) {
            stop();
            return;
          }
          const item = sentencesQueue[currentIdx];
          clearHighlights();

          if (activeBoxId) {
            const btn = document.querySelector(`[data-listen-for="${activeBoxId}"]`);
            if (btn) {
              btn.classList.add('speaking');
              btn.innerHTML = '⏹ Hentikan';
            }
            const span = document.querySelector(`#${activeBoxId} .narration-sentence[data-sidx="${currentIdx}"]`);
            if (span) span.classList.add('speaking-active');
          }

          const utter = new SpeechSynthesisUtterance(item);
          utter.lang = 'id-ID';
          utter.rate = appState.audio.rate || 0.95;

          if (appState.audio.voiceURI && availableVoices.length > 0) {
            const chosen = availableVoices.find(v => v.voiceURI === appState.audio.voiceURI);
            if (chosen) utter.voice = chosen;
          }

          utter.onend = () => {
            if (!isSpeaking) return;
            currentIdx++;
            speakNextSentence();
          };

          utter.onerror = () => {
            if (!isSpeaking) return;
            currentIdx++;
            speakNextSentence();
          };

          window.speechSynthesis.speak(utter);
        } catch (e) {
          stop();
        }
      }

      function speakBox(boxId, onComplete = null) {
        try {
          if (isSpeaking && activeBoxId === boxId) {
            stop();
            return;
          }
          stop();
          const box = document.getElementById(boxId);
          if (!box) return;
          const spans = Array.from(box.querySelectorAll('.narration-sentence'));
          const texts = spans.map(s => s.textContent.trim()).filter(Boolean);
          if (texts.length === 0) return;

          activeBoxId = boxId;
          sentencesQueue = texts;
          currentIdx = 0;
          isSpeaking = true;
          isPaused = false;
          onDoneCallback = onComplete;
          speakNextSentence();
        } catch (e) {
          stop();
        }
      }

      function speakPlainText(text) {
        try {
          if (!text || !('speechSynthesis' in window)) return;
          stop();
          const utter = new SpeechSynthesisUtterance(text);
          utter.lang = 'id-ID';
          utter.rate = appState.audio.rate || 0.95;
          if (appState.audio.voiceURI && availableVoices.length > 0) {
            const chosen = availableVoices.find(v => v.voiceURI === appState.audio.voiceURI);
            if (chosen) utter.voice = chosen;
          }
          window.speechSynthesis.speak(utter);
        } catch (e) {}
      }

      return { speakBox, speakPlainText, stop, pause, resume, refreshVoices };
    })();

    /* Helper untuk memecah teks narasi menjadi kalimat-kalimat terpisah untuk sorotan */
    function renderNarrationBox(boxId, rawText, label = 'Narasi Materi') {
      const sentences = rawText.match(/[^.!?]+[.!?]+(?:\s|$)/g) || [rawText];
      const spansHtml = sentences
        .map((s, idx) => `<span class="narration-sentence" data-sidx="${idx}">${s.trim()}</span>`)
        .join(' ');

      return `
        <div class="narration-box" id="${boxId}">
          <div class="narration-header">
            <span class="narration-label">🎧 ${label}</span>
            <button type="button" class="btn btn-listen" data-listen-for="${boxId}" onclick="NarrationEngine.speakBox('${boxId}')">
              ▶ Dengarkan
            </button>
          </div>
          <p style="margin:0;font-size:1rem;">${spansHtml}</p>
        </div>
      `;
    }

